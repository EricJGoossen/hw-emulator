# A D435-like camera on the barrel: 640 x 480 at 30 Hz. Its mount turns the
# camera's axes (x forward, y left, z up) back onto the world's at rest.
sensor: d435
kind: camera
attach: {archetype: turret, joint: pitch}
config:
  period: 0.0333333
  mount: {translation: [0, 0, 0.1], rotation: [0.5, 0.5, 0.5, -0.5]}
  width: 640
  height: 480
  fx: 615.0
  fy: 615.0
  cx: 320.0
  cy: 240.0
  far: 10
